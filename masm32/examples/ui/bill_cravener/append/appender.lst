			      C 
			      C     ArgCount MACRO number
			      C       LOCAL txt
			      C       txt equ <typedef PROTO :DWORD>
			      C         REPEAT number - 1
			      C           txt CATSTR txt,<,:DWORD>
			      C         ENDM
			      C       EXITM <txt>
			      C     ENDM
			      C 
			      C     pr0  typedef PROTO
			      C     pr1  ArgCount(1)
			      C     pr2  ArgCount(2)
			      C     pr3  ArgCount(3)
			      C     pr4  ArgCount(4)
			      C     pr5  ArgCount(5)
